{
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-tailwindcss"],
  "importOrder": [
    "^react$|^react-dom$",
    "^next$|^next/",
    "^@/lib/utils$",
    "^@/",
    "<THIRD_PARTY_MODULES>",
    "^[./]"
  ],
  "importOrderSortSpecifiers": true,
  "tailwindFunctions": ["cva", "cn"],
  "tailwindStylesheet": "./src/styles/globals.css"
}
